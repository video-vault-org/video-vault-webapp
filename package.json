{
  "name": "video-vault-webapp",
  "version": "0.0.1",
  "description": "End-to-end encrypted video collection - WebApp",
  "contributors": [
    {
      "name": "johanna-herrmann",
      "email": "johanna.herrmann@mailbox.org"
    }
  ],
  "private": false,
  "type": "module",
  "main": "built/lib/index.js",
  "bin": {
    "videovaultweb": "built/lib/index.js",
    "videovault-admin-init": "built/lib/initialize-admin.js",
    "videovault-config-init": "built/lib/initialize-config.js"
  },
  "scripts": {
    "audit": "better-npm-audit audit",
    "lint": "eslint '**/*.ts'",
    "test": "jest --runInBand --verbose --detectOpenHandles --forceExit",
    "qa": "npm run lint && npm run audit && npm run test",
    "build": "rimraf ./built && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "start": "node built/lib/index.js",
    "admin:init": "node built/lib/initialize-admin.js",
    "config:init": "node built/lib/initialize-config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johanna-herrmann/video-vault-org/video-vault-webapp.git"
  },
  "keywords": [
    "video",
    "encrypt",
    "encrypted",
    "encryption",
    "web"
  ],
  "author": "Johanna Herrmann",
  "license": "MIT",
  "homepage": "https://github.com/johanna-herrmann/video-vault-org/video-vault-webapp#readme",
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.13.0",
    "@testcontainers/minio": "^11.14.0",
    "@testcontainers/mongodb": "^11.10.0",
    "@testcontainers/postgresql": "^11.10.0",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.7.7",
    "@types/pg": "^8.16.0",
    "@types/prompts": "^2.4.9",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "@typescript-eslint/parser": "8.10.0",
    "better-npm-audit": "^3.11.0",
    "esbuild-jest": "0.5.0",
    "eslint": "9.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-dynamodb": "^3.1170.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13.2.0",
    "prompts": "^2.4.2",
    "typebox": "^1.4.7",
    "zod": "^4.6.7"
  }
}
